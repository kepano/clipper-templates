{
	"schemaVersion": "0.1.0",
	"name": "Perplexity",
	"behavior": "create",
	"noteContentFormat": "{{content}}",
	"properties": [
		{
			"name": "title",
			"value": "{{title}}",
			"type": "text"
		},
		{
			"name": "source",
			"value": "{{url}}",
			"type": "text"
		},
		{
			"name": "created",
			"value": "{{date}}",
			"type": "date"
		},
		{
			"name": "tags",
			"value": "perplexity/conversation, ai, research",
			"type": "multitext"
		}
	],
	"triggers": [
		"https://www.perplexity.ai/search/"
	],
	"noteNameFormat": "{{title}}",
	"path": "Clippings"
}
