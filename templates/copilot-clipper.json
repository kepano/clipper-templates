{
	"schemaVersion": "0.1.0",
	"name": "Microsoft Copilot",
	"behavior": "create",
	"noteContentFormat": "{{content}}",
	"properties": [
		{
			"name": "title",
			"value": "{{title}}",
			"type": "text"
		},
		{
			"name": "source",
			"value": "{{url}}",
			"type": "text"
		},
		{
			"name": "created",
			"value": "{{date}}",
			"type": "date"
		},
		{
			"name": "tags",
			"value": "copilot/conversation, ai",
			"type": "multitext"
		}
	],
	"triggers": [
		"https://copilot.microsoft.com/"
	],
	"noteNameFormat": "{{title}}",
	"path": "Clippings"
}
